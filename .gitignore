# ── Генерируемые файлы ──────────────────────────────
# Excel-файлы, создаваемые скриптом generate_template.py и экспортом
*.xlsx
*.xls
*.xlsm

# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Локальная копия ExcelJS для userscript (как extension/lib/ — D5)
# Сначала исключаем содержимое корневого lib/, затем возвращаем exceljs.min.js.
# Ведущий "/" ограничивает правило корнем репозитория — extension/lib/ не затрагивается.
/lib/*
!/lib/exceljs.min.js
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Виртуальные окружения
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# pip / менеджеры пакетов
Pipfile.lock
poetry.lock

# ── Системный мусор ─────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# ── Редакторы / IDE ─────────────────────────────────
# JetBrains (IntelliJ, PyCharm, WebStorm)
.idea/
*.iml
*.ipr
*.iws

# VS Code — настройки редактора личные, в репозиторий не идут
.vscode/

# Внутренние планы разработки — рабочие заметки, не для публикации
plans/

# Диагностические отчёты отладки — временные md-файлы, не для публикации
diagn/

# ── Chrome Extension ──────────────────────────────────
# extension/lib/exceljs.min.js уже в git; правило /lib/* действует только на корневой lib/
# generate_icons.py — утилита сборки, не для репозитория
extension/generate_icons.py
